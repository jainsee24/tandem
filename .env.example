PASSWORD=change-me
PORT=8080
# HEADLESS=0 (default): run Chrome headful inside an auto-started Xvfb display.
# This avoids bot detection (clean User-Agent + real WebGL). Set 1 for the old
# headless mode (faster, but many sites flag it as a bot).
HEADLESS=0
XVFB_DISPLAY=:99
# Hard cap per agent task, in minutes. Agentic browsing (multi-step forms,
# research, comparisons) can run long, so this is generous by default.
TASK_TIMEOUT_MIN=180
CHROME_BIN=/snap/bin/chromium
# Screencast JPEG quality (1-100). Lower = smaller frames = smoother over a slow
# tunnel; higher = sharper. Frame rate is render-bound, not quality-bound.
SCREENCAST_QUALITY=60
# CDP port chrome listens on; keep .mcp.json's --cdp-endpoint in sync.
CDP_PORT=9222
# Agent defaults (the UI dropdown overrides per conversation). Opus 5 at medium
# effort is the fast-and-smart default; DEFAULT_EFFORT is low|medium|high|xhigh|max.
DEFAULT_MODEL=claude-opus-5
DEFAULT_EFFORT=medium
# Ask Claude Code for fast mode on Opus (no-op until the org enables it). 0 = off.
AGENT_FAST_MODE=1
# Egress IP is the one bot signal no fingerprint fix can cover (datacenter /
# university ASNs draw Cloudflare and Google challenges regardless). Route
# chrome through a residential proxy or VPN to leave via a clean IP:
# CHROME_PROXY=socks5://127.0.0.1:1080
# Where the chrome profile (cookies, logins) lives; default ./chrome-profile
# CHROME_PROFILE_DIR=/path/to/profile
